{
  "name": "swapboard-frontend",
  "version": "1.0.0",
  "description": "Swapboard frontend - static HTML/CSS/JS",
  "author": "Zak Cole <zak@numbergroup.xyz> (https://numbergroup.xyz)",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "serve": "npx serve . -p 3000",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:e2e": "node test.js",
    "test:local": "npx serve . -p 3456 & sleep 2 && node test.js http://localhost:3456; kill %1 2>/dev/null || true",
    "test:coverage": "jest --coverage",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "format": "prettier --write '*.js' '*.json' '*.css'",
    "format:check": "prettier --check '*.js' '*.json' '*.css'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.10.1",
    "puppeteer": "^25.17.0",
    "serve": "^14.2.8"
  },
  "engines": {
    "node": ">=22"
  }
}
