# Swapboard Deployment Configuration
# Copy to .env and fill in values before running deploy.sh

# ============================================================
# Contract Deployment (required)
# ============================================================

# Private key: Use Foundry keystore instead of .env
# Run: cast wallet import deployer --interactive
# The keystore is encrypted and password-prompted at deploy time

# RPC endpoints (at least one required)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# WETH contract address (required for deployment)
# Mainnet: 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# Sepolia: 0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
WETH_ADDRESS=

# ============================================================
# Subgraph Deployment (required for subgraph)
# ============================================================

# Goldsky API key, read directly by the goldsky CLI
# Get from: https://app.goldsky.com/ -> Settings -> API Keys
# Install the CLI with: pnpm add -g @goldskycom/cli
GOLDSKY_API_KEY=

# Which subgraph to build and deploy: v1 or v2 (default v2)
# SUBGRAPH_VERSION=v2

# Goldsky subgraph to publish under, as <name>/<version>.
# Defaults to Swapboard/1.0.0 for v1 and swapboard-v2/2.0.0 for v2.
# GOLDSKY_SUBGRAPH=swapboard-v2/2.0.0

# ============================================================
# Optional Overrides
# ============================================================

# Skip individual deployment steps
# SKIP_CONTRACT=true
# SKIP_SUBGRAPH=true
# SKIP_FRONTEND=true

# Manual overrides (if skipping contract deployment)
# CONTRACT_ADDRESS=0x...
# START_BLOCK=12345678
# SUBGRAPH_URL=https://api.goldsky.com/api/public/project_YOUR_ID/subgraphs/swapboard-v2/2.0.0/gn
