{
  "framework": null,
  "buildCommand": "mkdir -p dist && for f in index.html app.js lib.js style.css mock.js API.html manifest.json sw.js; do cp \"$f\" \"dist/$f\"; done",
  "outputDirectory": "dist",
  "installCommand": "",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
