{
  "name": "swapboard-subgraph",
  "version": "1.0.1",
  "private": true,
  "description": "The Graph subgraph for Swapboard contract indexing",
  "author": "Zak Cole <zak@numbergroup.xyz> (https://numbergroup.xyz)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph codegen && graph build",
